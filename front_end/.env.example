# Leave both unset for local dev — vite.config.ts proxies /api to localhost:8000.

# Set to test the UI with zero backend running. Signup/login/upload all
# return fake in-memory data instead of hitting the network.
# VITE_USE_MOCK_API=true

# Set this to your real backend URL for a standalone/production deployment
# (ignored if VITE_USE_MOCK_API=true).
# VITE_API_BASE_URL=https://api.yourapp.com
